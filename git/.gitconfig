[user]
	email = tkindy@hubspot.com
	name = Tyler Kindy
	signingkey = /Users/tkindy/.ssh/id_rsa.pub
[core]
	hooksPath = /Users/tkindy/.git_hooks
	excludesfile = /Users/tkindy/.gitignore_global
[commit]
	gpgsign = true
[remote "origin"]
	prune = true
[hub]
	host = git.hubteam.com
[pull]
	rebase = true
[advice]
	detachedHead = false
	macheteEditorSelection = false
[rebase]
	updateRefs = true
	autosquash = true
[gpg]
	format = ssh
[rerere]
	enabled = true
[merge]
	conflictstyle = zdiff3
[diff]
	algorithm = histogram
[machete "github"]
	domain = git.hubteam.com
[init]
	defaultBranch = master
